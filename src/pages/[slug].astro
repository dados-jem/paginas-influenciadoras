---
import pages from '../content/pages.json';
import InfluencerLanding from '../layouts/InfluencerLanding.astro';
import '../styles/campaign.css';
import {validateRegistry} from '../lib/page-registry.mjs';
const bodies = import.meta.glob('../content/*.html', { query: '?raw', import: 'default', eager: true });
export function getStaticPaths() {
  return validateRegistry(pages).map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const content = bodies['../content/' + page.key + '.html'];
if (typeof content !== 'string') throw Error('Missing landing content: ' + page.key);
---
<InfluencerLanding page={page} content={content} />
