{
  "name": "@joao-maria/paginas-influenciadoras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "repository": "node scripts/repository.mjs"
  },
  "dependencies": { "astro": "7.3.2" },
  "devDependencies": { "wrangler": "4.130.0" }
}
