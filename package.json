{
  "name": "@joao-maria/paginas-influenciadoras",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/check-workflow.mjs && node scripts/compositions.mjs --check && astro build && node scripts/verify.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/compositions.mjs",
    "page:create": "node scripts/page-create.mjs",
    "publication:record": "node scripts/publication-receipts.mjs",
    "skill:check": "node scripts/check-workflow.mjs",
    "deploy": "node scripts/lp.mjs",
    "repository": "node scripts/repository.mjs",
    "deploy:preview": "node scripts/deploy.mjs",
    "verify:lp": "node scripts/lp.mjs --verify",
    "setup": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/jm.mjs doctor",
    "login": "node scripts/jm.mjs login"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "wrangler": "4.130.0"
  }
}
