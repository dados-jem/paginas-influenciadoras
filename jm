#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
tool="$project_dir/.runtime/tools/pixi/pixi"
[ -x "$tool" ] || { printf '%s\n' 'Execute primeiro: sh iniciar.sh --apply' >&2; exit 2; }
if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$tool" | awk '{print $1}'); else actual=$(shasum -a 256 "$tool" | awk '{print $1}'); fi
[ -f "$project_dir/.runtime/tools/pixi/binary.sha256" ] && [ "$actual" = "$(cat "$project_dir/.runtime/tools/pixi/binary.sha256")" ] || exit 2
cd "$project_dir"
exec "$tool" run --locked node scripts/jm.mjs "$@"
